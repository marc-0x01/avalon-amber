{
  // ============================================================
  // VS Code (Void's "vscode" package actually builds Code - OSS,
  // hence this path) - minimal setup, adapted from
  // igorbabko/vscode-setup (branch 2025) and re-themed for
  // "Avalon Amber". Managed via chezmoi. Palette source of truth:
  // dot_config/kitty/kitty.conf's ANSI color0-15 / foreground /
  // background - same trick already used for bat and helix,
  // nothing to keep in sync separately.
  // ============================================================

  // ---- Minimal UI (from the reference repo, unchanged) ----
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "single",
  "workbench.statusBar.visible": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.sideBar.location": "right",
  "window.commandCenter": false,
  // "" doesn't work - windowTitle.ts falls back to
  // `getWindowTitle() || productService.nameLong` ("Code - OSS"), and ""
  // is falsy in JS so the fallback always wins. A single space is
  // truthy, so it renders as blank instead.
  "window.title": " ",
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.hidesExplorerArrows": true,
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 8,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.decorations.badges": false,
  "git.decorations.enabled": false,
  "window.customTitleBarVisibility": "never",
  // This rig runs at 144 DPI (gtk-xft-dpi=147456 in dot_config/gtk-3.0,
  // gtk-4.0, qt6ct - same 1.5x bump behind every other app's 14pt fonts)
  // with the compositor's own monitor scale left at 1 (dot_config/hypr/
  // settings.conf). Electron doesn't read that GTK/Qt DPI setting, so
  // without this VS Code alone renders at stock 96 DPI. zoomLevel 2
  // (Chromium's 1.2^2, ~1.44x) read as too big; 1 (1.2^1, ~1.2x) splits
  // the difference between that and stock. Fine-tune live with
  // Ctrl+=/Ctrl+- if needed.
  "window.zoomLevel": 1,

  // ---- Editor: same font family/size as the integrated terminal below ----
  "editor.multiCursorModifier": "alt",
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "block",
  "editor.fontFamily": "'3270 Nerd Font Mono'",
  "editor.fontSize": 14,
  "editor.fontLigatures": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      { "scope": "comment", "settings": { "foreground": "#4a3823", "fontStyle": "italic" } },
      { "scope": "string", "settings": { "foreground": "#a67f35" } },
      { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#9c8148" } },
      { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#dcae4a" } },
      { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#d1b060" } },
      { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.name.tag"], "settings": { "foreground": "#e2c274" } }
    ]
  },
  "editor.stickyScroll.enabled": false,
  "editor.colorDecorators": false,
  "editor.codeLens": false,
  "editor.links": false,
  "editor.matchBrackets": "never",
  "editor.parameterHints.enabled": false,
  "editor.lightbulb.enabled": "off",
  "editor.hover.enabled": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "scm.diffDecorations": "none",
  "editor.lineNumbers": "relative",
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.showFoldingControls": "never",
  "editor.guides.indentation": false,
  "editor.renderWhitespace": "none",
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.quickSuggestions": { "other": "off" },
  "editor.suggestOnTriggerCharacters": false,
  "editor.tabCompletion": "on",
  "editor.snippetSuggestions": "top",
  "emmet.triggerExpansionOnTab": true,
  "files.autoSave": "afterDelay",
  "update.mode": "none",
  "extensions.ignoreRecommendations": true,
  // Void's "vscode" package ships Code - OSS without the proprietary
  // @vscode/vsce-sign module, so it can never verify Marketplace
  // signatures and refuses every install by default ("Signature
  // verification was not executed") - confirmed a Void packaging gap,
  // not fixable from settings alone otherwise. Safe to disable here:
  // xbps itself already integrity-checks every package on this
  // machine, and every extension this rice installs is pinned by exact
  // ID in system-setup.sh, not picked from search results.
  "extensions.verifySignature": false,

  // ---- Integrated terminal: same font/size as the editor below
  // (23px measured too big in practice - reverted to 14, matching the
  // number kitty uses even though the physical DPI math doesn't line up
  // exactly; the family fix (Regular, not Condensed) is what actually
  // mattered visually - see dot_config/fontconfig/conf.d) ----
  "terminal.integrated.fontFamily": "'3270 Nerd Font Mono'",
  "terminal.integrated.fontSize": 14,
  // Shell integration's per-command gutter dot to the left of the
  // prompt - purely cosmetic, not needed for the CWD-tracking/command
  // navigation shell integration still provides underneath.
  "terminal.integrated.shellIntegration.decorationsEnabled": "never",

  // ---- Avalon Amber palette (from kitty.conf color0-15 / fg / bg).
  // Deliberately NOT touching editorError.foreground / editorWarning.foreground -
  // real error/warning squiggles keep VS Code's default red/yellow so they
  // still stand out against an otherwise monochrome-amber UI.
  "workbench.colorCustomizations": {
    // Global text/icon fallback - "Default Dark Modern" leaves a lot of
    // UI chrome (menu items, dialog text, misc labels, and every
    // codicon-based toolbar button - terminal panel's new/split/kill
    // icons, explorer actions, editor actions, etc.) on its own
    // near-white default unless something more specific overrides it;
    // these two catch all of that in one place, app-wide.
    "foreground": "#c9973a",
    "descriptionForeground": "#8a6d3f",
    "icon.foreground": "#c9973a",
    "editor.background": "#0d0906",
    "editor.foreground": "#c9973a",
    "editor.selectionBackground": "#4a3823",
    "editorCursor.foreground": "#e8b969",
    "editorCursor.background": "#000000",
    "editorGroupHeader.tabsBackground": "#0d0906",
    "tab.activeBackground": "#17110a",
    "tab.activeForeground": "#f4e4c1",
    "tab.inactiveBackground": "#0d0906",
    "tab.inactiveForeground": "#8a6d3f",
    "sideBar.background": "#17110a",
    "sideBar.foreground": "#8a6d3f",
    "sideBarTitle.foreground": "#c9973a",
    "activityBar.background": "#17110a",
    "titleBar.activeBackground": "#0d0906",
    "titleBar.activeForeground": "#c9973a",
    "titleBar.inactiveBackground": "#0d0906",
    "titleBar.inactiveForeground": "#4a3823",
    "statusBar.background": "#0d0906",
    "statusBar.foreground": "#c9973a",
    "panel.background": "#0d0906",
    "panel.border": "#4a3823",
    "focusBorder": "#4a3823",
    "list.activeSelectionBackground": "#4a3823",
    "list.activeSelectionForeground": "#f4e4c1",
    "list.hoverBackground": "#17110a",
    "list.inactiveSelectionBackground": "#17110a",
    "input.background": "#17110a",
    "input.foreground": "#c9973a",
    "dropdown.background": "#17110a",
    "dropdown.foreground": "#c9973a",
    "editorWidget.background": "#17110a",
    "editorSuggestWidget.background": "#17110a",
    "editorSuggestWidget.selectedBackground": "#4a3823",
    "badge.background": "#4a3823",
    "badge.foreground": "#f4e4c1",
    "progressBar.background": "#c9973a",

    // "Default Dark Modern"'s default accent color is blue - these are
    // every spot that leaks through despite the rest of the theming
    // above (buttons, links, checkboxes, menus, pickers).
    "button.background": "#4a3823",
    "button.foreground": "#f4e4c1",
    "button.hoverBackground": "#8f6a2e",
