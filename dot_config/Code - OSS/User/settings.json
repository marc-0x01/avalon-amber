    "terminal.ansiWhite": "#c9973a",
    "terminal.ansiBrightBlack": "#4a3823",
    "terminal.ansiBrightRed": "#b6752a",
    "terminal.ansiBrightGreen": "#cf9a3f",
    "terminal.ansiBrightYellow": "#dcae4a",
    "terminal.ansiBrightBlue": "#9c8148",
    "terminal.ansiBrightMagenta": "#d1b060",
    "terminal.ansiBrightCyan": "#e2c274",
    "terminal.ansiBrightWhite": "#f4e4c1",

    // ============================================================
    // Everything below fills in the rest of VS Code's ~500 theme color
