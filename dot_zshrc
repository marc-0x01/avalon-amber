# ============================================================
# Zsh / Oh My Zsh.
# Part of the "Avalon Amber" rice. Managed via chezmoi.
# ============================================================

### Oh My ZSH Configuration

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
# ZSH_THEME="robbyrussell"

# Completion parameters
CASE_SENSITIVE="false"
HYPHEN_INSENSITIVE="false"

# Auto-update behavior
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 15

# Feature flags
DISABLE_MAGIC_FUNCTIONS="false"
DISABLE_LS_COLORS="false"
DISABLE_AUTO_TITLE="false"
ENABLE_CORRECTION="false"
COMPLETION_WAITING_DOTS="true"
DISABLE_UNTRACKED_FILES_DIRTY="false"

# Plugins
# sudo: double-tap Esc to prepend "sudo " to the current/previous command.
# chezmoi/gh/podman: completions + aliases matching tools already on this
# machine. z: frecency-based "cd" directory jumping, pure zsh (no zoxide
# binary needed). history-substring-search: type a fragment, ↑/↓ cycles
# matching history entries.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting starship sudo chezmoi gh podman z history-substring-search)

## Sourcing OMZ
source $ZSH/oh-my-zsh.sh

# User configuration
export PATH="$HOME/.local/bin:$PATH"
export EDITOR='hx'
export VISUAL="$EDITOR"

# Aliases
alias cls='clear'
alias q='exit'
alias cat='bat --paging=never'
alias x='dtrx'

# Re-fire udev "add" events for input devices - unsticks a stuck
# trackpad/rmi4 device without needing a reboot.
alias unstick-trackpad='sudo udevadm trigger --action=add --subsystem-match=input'

# Launch the zellij "devel" layout: claude-code left, hx top-right,
# shell bottom-right.
alias zellij-dev='zellij --new-session-with-layout devel'

# chezmoi shortcuts. The omz "chezmoi" plugin above only adds
# completion, no aliases, so these are hand-rolled.
alias cm='chezmoi'
alias cma='chezmoi apply'
alias cmd='chezmoi diff'
alias cme='chezmoi edit'
alias cms='chezmoi status'
alias cmu='chezmoi update'
alias cmcd='chezmoi cd'

# Stateless Claude Code invocations for Unix pipes - pure text-in/
# text-out filters, no side effects either way:
# --no-session-persistence writes no transcript to ~/.claude/projects
# (nothing to resume, nothing left behind); --tools="" disables tool
# calls entirely (no file/shell access - it can only transform the
# text you hand it, which is also what actually guarantees no memory
# file could get written, regardless of --bare below). --tools="" must
# use "=", not a space - as a space-separated arg the empty string
# swallows the next word (your actual prompt) into the same variadic
# flag instead of leaving it as the prompt.
#
# Two variants, two auth methods, two bills:
#   ask   - OAuth login (`claude auth login`), billed to the Pro
#           subscription. No --bare, since --bare only ever reads
#           ANTHROPIC_API_KEY/apiKeyHelper and never OAuth.
#   probe - --bare (skips hooks/LSP/plugin-sync/keychain/CLAUDE.md
#           auto-discovery - faster, fully isolated context), billed
#           per-token against Console prepaid credit instead. Needs an
#           "anthropic-api-key" entry in the Bitwarden vault (its
#           password field: `rbw add anthropic-api-key`, paste the key
#           from console.anthropic.com as the first line) and the
#           vault unlocked in this shell (`rbw unlock`) before use.
alias ask='claude -p --no-session-persistence --tools=""'
alias probe='ANTHROPIC_API_KEY=$(rbw get anthropic-api-key) claude -p --no-session-persistence --bare --tools=""'

# Fun / novelty
alias starwars='telnet towel.blinkenlights.nl'
alias parrot='curl -s parrot.live'
alias telehack='telnet telehack.com'
alias mapscii='telnet mapscii.me'
alias chucknorris='curl -s https://api.chucknorris.io/jokes/random | jq -r .value'
alias wttr='curl -s wttr.in'                     # ASCII weather report
alias dadjoke='curl -s -H "Accept: text/plain" https://icanhazdadjoke.com; echo'
alias mystery='man woman'                        # "No entry for woman in the manual."
alias matrix='L=${LINES:-$(tput lines)}; C=${COLUMNS:-$(tput cols)}; echo -e "\e[32m"; while :; do echo -en "\033[$((RANDOM%L));$((RANDOM%C))H\033[32m${RANDOM:0:1}"; done'

# starship prompt is initialized by the oh-my-zsh "starship" plugin above

# Welcome banner
fastfetch
