# Repo documentation, not dotfiles - chezmoi doesn't ignore these by
# default (only files/dirs starting with "." in the source root are
# implicitly ignored), so without this they'd get applied straight
# into $HOME as ~/README.md and ~/LICENSE.
README.md
LICENSE

# Backups of root-owned files (GRUB theme, ly login theme) that live
# outside $HOME entirely. Not meant to be applied by chezmoi at all -
# system-setup.sh reads these directly via `chezmoi source-path` and
# installs them with sudo. Without this, chezmoi would try to apply
# it straight into ~/root-overlay/..., which is nonsense.
root-overlay
